# URL base de la API REST (Spring Boot). En desarrollo se usa el proxy de Vite (/api -> VITE_PROXY_TARGET).
VITE_API_URL=/api

# Destino del proxy de desarrollo (vite.config.js)
VITE_PROXY_TARGET=http://localhost:8080

# true  -> los servicios devuelven datos simulados (src/mocks) y no se llama al servidor
# false -> todas las peticiones van al backend real
VITE_USE_MOCKS=true

# Muestra el botón flotante "Zonas dinámicas" que resalta en pantalla los bloques que vienen del servidor
VITE_SHOW_DYNAMIC_ZONES=true
